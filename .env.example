# Copie para .env e ajuste. O .env está no .gitignore.
DB_PORT=5433
DB_PASSWORD=webhook
# Segredo HMAC compartilhado com o provedor (mínimo de 32 caracteres).
WEBHOOK_PAYMENT_SECRET=local-dev-only-secret-change-me-0123456789
# API do cliente que recebe o webhook de saída e o segredo HMAC combinado com ele.
WEBHOOK_NOTIFICATION_URL=http://localhost:8081/webhooks/payment-notifications
WEBHOOK_NOTIFICATION_SECRET=local-dev-only-client-secret-0123456789abc
